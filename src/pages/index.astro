---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { ru as copy, site } from "../data/site";
---

<Layout>
  <a class="skip-link" href="#main">
    {copy.skip}
  </a>
  <header class="site-header" id="top">
    <div class="container header-inner">
      <a class="brand" href="#top" aria-label="UzStack — на главную">
        <img src="/favicon.svg" width="34" height="34" alt="" />
        <span>
          UzStack<span class="brand-dot">.</span>
        </span>
      </a>
      <nav id="main-nav" aria-label={copy.navLabel}>
        {copy.nav.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
        <a class="mobile-contact" href="#contact">
          {copy.contactCta}
        </a>
      </nav>
      <div class="header-actions">
        <button
          class="theme-toggle icon-button"
          type="button"
          aria-label={copy.theme}
          aria-pressed="false"
          hidden
        >
          <span class="moon">
            <Icon name="moon" size={20} />
          </span>
          <span class="sun">
            <Icon name="sun" size={20} />
          </span>
        </button>
        <a class="button button-small header-cta" href="#contact">
          {copy.contactCta}
          <Icon name="external" size={17} />
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-controls="main-nav"
          aria-expanded="false"
          hidden
        >
          <span>{copy.menu}</span>
          <span class="menu-lines" aria-hidden="true"></span>
        </button>
      </div>
    </div>
  </header>
  <main id="main">
    <section class="hero container" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="status-dot"></span>
          {copy.hero.eyebrow}
        </p>
        <h1 id="hero-title">
          {copy.hero.title.map((line, index) => (
            <span class:list={{ "accent-text": index === 2 }}>{line}</span>
          ))}
        </h1>
        <p class="hero-description">{copy.hero.description}</p>
        <div class="hero-actions">
          <a class="button" href="#contact">
            {copy.contactCta}
            <Icon name="external" size={20} />
          </a>
          <a class="text-link" href="#services">
            {copy.hero.secondary}
            <Icon name="arrow" size={19} />
          </a>
        </div>
        <p class="hero-note">
          <span aria-hidden="true">↳</span>
          {copy.hero.note}
        </p>
      </div>
      <div class="architecture-panel">
        <div class="panel-heading">
          <span class="tiny-label">UZSTACK / АРХИТЕКТУРА</span>
          <span class="panel-cross" aria-hidden="true">
            +
          </span>
        </div>
        <div class="panel-title">
          {copy.hero.visualTitle}
          <br />
          <span>{copy.hero.visualSubtitle}</span>
        </div>
        <img
          class="stack-illustration"
          src="/brand/stack-architecture.svg"
          width="600"
          height="520"
          alt={copy.hero.visualLabel}
          fetchpriority="high"
        />
        <div class="layer-labels">
          {copy.hero.layers.map((layer) => (
            <span>{layer}</span>
          ))}
        </div>
        <div class="panel-footer">
          <span class="status-dot"></span>
          {copy.hero.visualFooter}
          <span aria-hidden="true">↗</span>
        </div>
      </div>
    </section>
    <div class="tech-ribbon">
      <div class="container">
        <span>
          Идея <span aria-hidden="true">→</span> Архитектура{" "}
          <span aria-hidden="true">→</span> Реализация
        </span>
        <span class="ribbon-tools">
          .NET <i>/</i> PostgreSQL <i>/</i> Avalonia <i>/</i> TypeScript
        </span>
      </div>
    </div>
    <section
      class="section container"
      id="services"
      aria-labelledby="services-title"
    >
      <div class="section-heading">
        <div>
          <p class="eyebrow">{copy.services.eyebrow}</p>
          <h2 id="services-title">{copy.services.title}</h2>
        </div>
        <p class="section-description">{copy.services.description}</p>
      </div>
      <div class="services-grid">
        {copy.services.items.map((item) => (
          <article class="service-card">
            <div class="service-top">
              <span class="service-icon">
                <Icon name={item.icon} size={27} />
              </span>
              <span class="card-number">/{item.number}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <ul class="tags" aria-label="Направления">
              {item.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
    <section
      class="technology-section"
      id="technology"
      aria-labelledby="technology-title"
    >
      <div class="container section">
        <div class="section-heading">
          <div>
            <p class="eyebrow">{copy.technology.eyebrow}</p>
            <h2 id="technology-title">{copy.technology.title}</h2>
          </div>
          <p class="section-description">{copy.technology.description}</p>
        </div>
        <div class="technology-grid">
          {copy.technology.items.map((item) => (
            <div class="technology-item">
              <span class="tech-mark" aria-hidden="true">
                {item.mark}
              </span>
              <h3>{item.name}</h3>
              <p>{item.role}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
    <section
      class="section container"
      id="products"
      aria-labelledby="products-title"
    >
      <p class="eyebrow">{copy.products.eyebrow}</p>
      <h2 id="products-title">{copy.products.title}</h2>
      <article class="product-card">
        <div class="product-copy">
          <span class="status-badge">
            <span class="status-dot"></span>
            {copy.products.status}
          </span>
          <h3>{copy.products.name}</h3>
          <p>{copy.products.description}</p>
          <p class="product-disclaimer">{copy.products.disclaimer}</p>
        </div>
        <div
          class="product-visual"
          role="img"
          aria-label={copy.products.visualLabel}
        >
          <span class="tiny-label">{copy.products.visualCaption}</span>
          <div class="product-diagram" aria-hidden="true">
            <span class="diagram-node node-one">
              <Icon name="web" />
            </span>
            <span class="diagram-node node-two">
              <Icon name="desktop" />
            </span>
            <span class="diagram-node node-three">
              <Icon name="mobile" />
            </span>
            <div class="diagram-orbit"></div>
            <div class="diagram-core">
              <img src="/favicon.svg" width="52" height="52" alt="" />
            </div>
          </div>
          <strong>{copy.products.visualTitle}</strong>
          <span class="product-visual-note">{copy.products.visualNote}</span>
        </div>
      </article>
      <article class="product-card uzi-card" aria-labelledby="uzi-title">
        <div class="product-copy">
          <span class="status-badge">
            <span class="status-dot"></span>
            {copy.uzi.status}
          </span>
          <h3 id="uzi-title">{copy.uzi.name}</h3>
          <span class="product-subtitle">{copy.uzi.subtitle}</span>
          <p>{copy.uzi.description}</p>
          <p class="product-disclaimer">{copy.uzi.disclaimer}</p>
          <ul class="tags" aria-label="Технологии UZI">
            {copy.uzi.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        </div>
        <div class="uzi-capabilities">
          <p>{copy.uzi.capabilitiesTitle}</p>
          <ul>
            {copy.uzi.capabilities.map((item) => (
              <li>
                <Icon name={item.icon} />
                <div>
                  <h4>{item.title}</h4>
                  <p>{item.description}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      </article>
    </section>
    <section
      class="section about-section container"
      id="about"
      aria-labelledby="about-title"
    >
      <div class="about-copy">
        <p class="eyebrow">{copy.about.eyebrow}</p>
        <h2 id="about-title">{copy.about.title}</h2>
        <p>{copy.about.description}</p>
        <p>{copy.about.approach}</p>
        <div class="origin-mark">
          <span class="origin-line"></span>
          <span>
            UzStack <span class="origin-separator">/</span> Узбекистан
          </span>
        </div>
      </div>
      <ol class="process-list">
        {copy.about.steps.map((step, index) => (
          <li>
            <span class="step-number">0{index + 1}</span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
    <section
      class="container contact-wrapper"
      id="contact"
      aria-labelledby="contact-title"
    >
      <div class="contact-panel">
        <div>
          <p class="eyebrow">{copy.contact.eyebrow}</p>
          <h2 id="contact-title">{copy.contact.title}</h2>
          <p class="contact-description">{copy.contact.description}</p>
          <p class="contact-note">{copy.contact.note}</p>
        </div>
        <span class="contact-decoration" aria-hidden="true"></span>
      </div>
    </section>
  </main>
  <footer class="container footer">
    <div>
      <a class="brand" href="#top">
        <img src="/favicon.svg" width="28" height="28" alt="" />
        <span>
          UzStack<span class="brand-dot">.</span>
        </span>
      </a>
      <p>{copy.footer.tagline}</p>
    </div>
    <div class="footer-links">
      <a href="#top">{copy.footer.top} ↑</a>
    </div>
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} UzStack</span>
      <span>{site.domain}</span>
    </div>
  </footer>
  <script>
    import "../scripts/navigation";
  </script>
</Layout>
