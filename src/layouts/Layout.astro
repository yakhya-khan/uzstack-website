---
import { site, ru } from "../data/site";
import "../styles/global.css";
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={ru.description} />
    <meta name="theme-color" content="#f7f9fc" />
    <link rel="canonical" href={`${site.url}/`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={ru.title} />
    <meta property="og:description" content={ru.description} />
    <meta property="og:url" content={`${site.url}/`} />
    <meta property="og:image" content={`${site.url}/brand/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="UzStack — Ваши задачи. Наш код. Общий результат."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{ru.title}</title>
    <script is:inline>
      (() => {
        let saved;
        try {
          saved = localStorage.getItem("uzstack-theme");
        } catch {}
        const dark =
          saved === "dark" ||
          (saved !== "light" &&
            matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.querySelector('meta[name="theme-color"]').content = dark
          ? "#0b1220"
          : "#f7f9fc";
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
